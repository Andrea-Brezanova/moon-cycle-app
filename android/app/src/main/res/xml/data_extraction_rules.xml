<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred to a new device. The database key
     lives in the Android Keystore, which never leaves the device, so a
     copied database could not be read anyway; and cycle data stays on this
     phone unless the user exports it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
